# Copy to .env.production on the mini-PC (/opt/apps/tally/repo/.env.production). Never commit it.

# Postgres (used by both containers).
POSTGRES_PASSWORD=change-me-long-random

# Cloudflare Access: Zero Trust > Settings > Custom pages shows the team domain;
# Access > Applications > tally > Overview shows the Application Audience (AUD) tag.
ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
ACCESS_AUD=paste-the-aud-tag

# Claude for categorizing merchants Tally hasn't seen (console.anthropic.com > API keys).
# Leave empty to run without it. Only the merchant name, amount and your category names are sent.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# Rule suggestions on the dashboard's Rules page (one call per click, at most 20 a day).
# ANTHROPIC_RULES_MODEL=claude-sonnet-5-5
# Model calls per day at most (each merchant is asked once, then cached).
# LLM_DAILY_LIMIT=200

# Receipts by email: Gmail over IMAP, read-only (needs ANTHROPIC_API_KEY too). Make an app
# password at myaccount.google.com > Security > App passwords (2-Step Verification on). It lasts
# until you revoke it or change your Google password. Only emails whose subject looks like a
# receipt are read; their text goes to Claude to pick out the store, total and card. No email
# is stored.
# GMAIL_ADDRESS=you@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# EMAIL_POLL_MINUTES=5
# Receipts a day Claude reads, at most.
# EMAIL_DAILY_LIMIT=100
# EMAIL_FOLDER=INBOX

# Local development only: skips the Access check entirely. Never set this in production.
# ACCESS_DISABLED=true
