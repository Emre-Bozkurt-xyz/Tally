<?xml version="1.0" encoding="utf-8"?>
<!-- Financial data never goes to cloud backup. Device-to-device transfer (new phone) is allowed. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
